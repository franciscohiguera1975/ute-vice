# ---- Datos de trabajo ----
# Los consolidados, padrones y reportes de origen viven **fuera** del
# repositorio, en `../data/`. Entraron aqui una vez —un zip de 82 MB que sigue
# en la historia— y basta un `git add -A` distraido para repetirlo.
docs/**/*.xlsx
docs/**/*.xls
docs/**/*.csv
docs/**/*.zip
# Archivos de bloqueo que deja LibreOffice mientras un libro esta abierto.
.~lock.*#

# `frontend/public` es carpeta de assets: **todo lo que hay ahi se publica en la
# web sin autenticacion**. Solo debe contener la marca —favicon y logotipos—, y
# no los informes que uno descarga mientras prueba. Se ignoran por tipo para que
# un `git add -A` distraido no los suba.
frontend/public/*.pdf
frontend/public/*.xlsx
frontend/public/*.xls
frontend/public/*.csv
frontend/public/*.docx

# Insumos de trabajo: consolidados, padrones del SICAF y lo que se descomprima
# de ellos. Son cientos de megas y cambian a diario; el repositorio guarda el
# codigo que los lee, no los archivos. La barra inicial ancla la regla a la
# raiz, para no ocultar ningun `data/` que apareciera dentro del codigo.
/data/

# ---- Editor / SO ----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
