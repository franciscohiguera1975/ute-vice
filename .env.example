# =====================================================================
# UTE-VICE — Variables de entorno (plantilla)
# Copiar a `.env` y ajustar. NUNCA versionar el `.env` real.
# =====================================================================

# ---------------------- Entorno general -----------------------------
APP_NAME="UTE Vice - Gestión Académica"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
TZ=America/Guayaquil

# ---------------------- PostgreSQL ----------------------------------
POSTGRES_USER=ute
POSTGRES_PASSWORD=cambiame_en_produccion
POSTGRES_DB=ute_vice
POSTGRES_HOST=postgres             # nombre del servicio en docker-compose
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433        # puerto expuesto al host (evita choque con psql local)

# ---------------------- Backend / FastAPI ---------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_EXTERNAL_PORT=8000
API_V1_PREFIX=/api/v1
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---------------------- Seguridad / JWT -----------------------------
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambiame_por_una_clave_larga_y_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=10

# Usuario administrador inicial (se crea con el comando `seed`)
FIRST_SUPERUSER_EMAIL=admin@ute.edu.ec
FIRST_SUPERUSER_PASSWORD=UteVice#2026.Inicial
FIRST_SUPERUSER_NAME=Administrador del Sistema

# ---------------------- Google OAuth 2.0 ----------------------------
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Dominios institucionales autorizados, separados por coma. Vacio = cualquiera.
GOOGLE_ALLOWED_DOMAINS=ute.edu.ec
# Rol asignado automaticamente a un usuario nuevo que entra por Google
GOOGLE_DEFAULT_ROLE=CONSULTA

# ---------------------- LDAP / Active Directory ---------------------
LDAP_ENABLED=false
LDAP_SERVER_URI=ldap://ad.ute.edu.ec:389
LDAP_USE_SSL=false
LDAP_BIND_DN=CN=svc_ute_vice,OU=Servicios,DC=ute,DC=edu,DC=ec
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=OU=Usuarios,DC=ute,DC=edu,DC=ec
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_FULL_NAME=displayName
LDAP_DEFAULT_ROLE=CONSULTA

# ---------------------- Proveedor SENESCYT --------------------------
# manual  -> cola human-in-the-loop: un operador resuelve el captcha en la UI
# mock    -> datos sinteticos, para desarrollo y pruebas automatizadas
# oficial -> API/convenio institucional (pendiente de habilitar)
SENESCYT_PROVIDER=mock
SENESCYT_BASE_URL=https://www.senescyt.gob.ec
SENESCYT_TIMEOUT_SECONDS=30
SENESCYT_MAX_ATTEMPTS=3
SENESCYT_OFICIAL_API_URL=
SENESCYT_OFICIAL_API_KEY=

# ---------------------- Planificador de consultas -------------------
SCHEDULER_ENABLED=false
# Duracion del periodo de cobertura: nadie se reconsulta hasta cerrarlo
SCHEDULER_PERIOD_DAYS=90
# Presupuesto maximo de consultas por hora (tope duro y conservador)
SCHEDULER_MAX_REQUESTS_PER_HOUR=30
# Franjas horarias y su peso relativo de actividad (hora local, TZ arriba)
SCHEDULER_PEAK_START_HOUR=8
SCHEDULER_PEAK_END_HOUR=17
SCHEDULER_OFFPEAK_END_HOUR=21
SCHEDULER_PEAK_WEIGHT=1.0
SCHEDULER_OFFPEAK_WEIGHT=0.35
# Separacion aleatoria entre consultas (segundos): evita rafagas
SCHEDULER_MIN_DELAY_SECONDS=45
SCHEDULER_MAX_DELAY_SECONDS=240
# Pausa progresiva si el proveedor responde con error o rechazo
SCHEDULER_BACKOFF_BASE_SECONDS=300
SCHEDULER_BACKOFF_MAX_SECONDS=7200
# Corta el job si se acumulan N fallos seguidos (protege al proveedor y a nosotros)
SCHEDULER_CIRCUIT_BREAKER_FAILURES=5

# ---------------------- Reportes ------------------------------------
REPORTS_OUTPUT_DIR=/app/storage/reports
REPORTS_MAX_ROWS=100000

# ---------------------- Frontend ------------------------------------
FRONTEND_EXTERNAL_PORT=4200
FRONTEND_API_URL=http://localhost:8000/api/v1
