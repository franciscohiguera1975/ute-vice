# =====================================================================
# Produccion — UTE Vice · Gestion Academica
# =====================================================================
# El archivo real vive en /opt/vice-gestion/.env con permisos 600 y NO se
# versiona. Este es solo la plantilla de que variables hacen falta.
#
# `ENVIRONMENT=production` activa un cerrojo en la configuracion: la
# aplicacion se niega a arrancar si alguno de los secretos sigue siendo el
# de ejemplo, si DEBUG queda en true o si CORS admite un origen http://
# que no sea local.
# =====================================================================

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
TZ=America/Guayaquil

APP_NAME="UTE Vice - Gestión Académica"

# --- Secretos. Generar con: openssl rand -base64 48 ---
SECRET_KEY=

# --- Base de datos (contenedor propio, aislado del resto del VPS) ---
POSTGRES_USER=ute_vice
POSTGRES_PASSWORD=
POSTGRES_DB=ute_vice

# --- Puertos publicados en 127.0.0.1. Distintos de los ya usados en el VPS ---
POSTGRES_EXTERNAL_PORT=5437
BACKEND_EXTERNAL_PORT=8100

# --- Origen publico ---
CORS_ORIGINS=https://vice-gestion.uaeftt-ute.site

# --- Superusuario inicial. Debe cambiar la clave en el primer acceso ---
FIRST_SUPERUSER_EMAIL=admin@ute.edu.ec
FIRST_SUPERUSER_PASSWORD=
FIRST_SUPERUSER_NAME="Administrador del Sistema"

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- SENESCYT: 'manual' usa la cola asistida por un operador humano ---
SENESCYT_PROVIDER=manual
SCHEDULER_ENABLED=false

# --- Google OAuth y LDAP: desactivados hasta que se aporten credenciales ---
GOOGLE_OAUTH_ENABLED=false
LDAP_ENABLED=false
